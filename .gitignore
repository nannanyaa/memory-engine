*.bak*
*.gov_bak*
*~
*.swp

# Runtime databases (created from live state, must not be committed)
memory-engine.db
lcm.db
*.db-wal
*.db-shm

# OS / editor
.DS_Store
*.log

# Local config / secrets
.env
.env.*
