# Dependencies
node_modules/

# Build artifacts already produced (dist/ is shipped, but ignore stray/backup bundles)
dist.bak*/
src.bak*/
rollback_*/

# Backup / scratch files
*.bak*
*.gov_bak*
*~
*.swp

# Runtime databases (created from live state, must not be committed)
memory-engine.db
lcm.db
*.db-wal
*.db-shm

# OS / editor
.DS_Store
*.log

# Local config / secrets
.env
.env.*

# 本地敏感/个性化配置（不进 git，运行自动生成模板）
keywords.json
memory-engine.keywords.json
memory-engine.local.config.json
